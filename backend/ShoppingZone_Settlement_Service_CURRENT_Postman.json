          "name": "Attempt another merchant settlement summary",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{merchant_token}}" }], "url": { "raw": "{{gatewayUrl}}/api/v1/settlements/merchant/{{other_merchant_id}}?weekStart={{week_start}}", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "settlements", "merchant", "{{other_merchant_id}}"], "query": [{ "key": "weekStart", "value": "{{week_start}}" }] } },
