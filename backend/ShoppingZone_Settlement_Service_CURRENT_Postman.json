          "name": "MERCHANT token - admin weekly settlement",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{merchant_token}}" }], "url": { "raw": "{{gatewayUrl}}/api/v1/settlements/weekly/run", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "settlements", "weekly", "run"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Merchant cannot run admin settlement', function () { pm.expect(pm.response.code).to.eql(403); });"] } }]
        },
        {
          "name": "DELIVERY_AGENT token - admin weekly settlement",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{delivery_partner_token}}" }], "url": { "raw": "{{gatewayUrl}}/api/v1/settlements/weekly/run", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "settlements", "weekly", "run"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Delivery agent cannot run admin settlement', function () { pm.expect(pm.response.code).to.eql(403); });"] } }]
        }
      ]
    },
    {
      "name": "14 - Reconciliation",
      "item": [
        {
          "name": "Merchant settlement summary / reconciliation view",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": { "raw": "{{gatewayUrl}}/api/v1/settlements/merchant/{{merchant_id}}?weekStart={{week_start}}", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "settlements", "merchant", "{{merchant_id}}"], "query": [{ "key": "weekStart", "value": "{{week_start}}" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reconciliation summary succeeded', function () { pm.expect(pm.response.code).to.eql(200); });", "var j = pm.response.json();", "pm.test('Summary has data object', function () { pm.expect(j).to.have.property('data'); });"] } }]
        }
      ]
    }
  ]
