{
  "info": {
    "_postman_id": "c5b3d4a0-1b0a-4a3f-8c4f-settlement-current",
    "name": "ShoppingZone Settlement Service - Current Implementation",
    "description": "Generated from the current settlement-service source, authentication source, Gateway route, Config Server configuration, and live settlement OpenAPI. Settlement business endpoints are routed by the Gateway at /api/v1/settlements/**. The current SecurityConfig requires ADMIN or INTERNAL for that entire path before method-level annotations are evaluated. Auth seeds DELIVERY_AGENT, while settlement method annotations mention DELIVERY_PARTNER; this collection preserves both source facts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8099" },
    { "key": "settlementUrl", "value": "http://localhost:8095" },
    { "key": "eurekaUrl", "value": "http://localhost:8761" },
    { "key": "authUrl", "value": "http://localhost:8086" },
    { "key": "admin_token", "value": "" },
    { "key": "merchant_token", "value": "" },
    { "key": "delivery_partner_token", "value": "" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "Admin@123" },
    { "key": "merchant_username", "value": "merchant1" },
    { "key": "merchant_password", "value": "Merchant@123" },
    { "key": "delivery_partner_username", "value": "delivery1" },
    { "key": "delivery_partner_password", "value": "Delivery@123" },
    { "key": "merchant_id", "value": "7030" },
    { "key": "other_merchant_id", "value": "7040" },
