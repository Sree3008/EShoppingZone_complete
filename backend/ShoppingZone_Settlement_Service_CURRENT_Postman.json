  "item": [
    {
      "name": "01 - Health and Swagger",
      "item": [
        {
          "name": "Settlement health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{settlementUrl}}/actuator/health", "host": ["{{settlementUrl}}"], "path": ["actuator", "health"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Health is available', function () { pm.expect(pm.response.code).to.eql(200); });"] } }]
        },
        {
          "name": "Settlement OpenAPI",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{settlementUrl}}/v3/api-docs", "host": ["{{settlementUrl}}"], "path": ["v3", "api-docs"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('OpenAPI is available', function () { pm.expect(pm.response.code).to.eql(200); });"] } }]
        },
        {
          "name": "Settlement Swagger UI",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{settlementUrl}}/swagger-ui.html", "host": ["{{settlementUrl}}"], "path": ["swagger-ui.html"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Swagger UI is available', function () { pm.expect(pm.response.code).to.eql(200); });"] } }]
        },
        {
          "name": "Gateway health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{gatewayUrl}}/actuator/health", "host": ["{{gatewayUrl}}"], "path": ["actuator", "health"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Gateway health endpoint responds', function () { pm.expect(pm.response.code).to.be.oneOf([200, 503]); });"] } }]
        },
        {
          "name": "Eureka applications",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{eurekaUrl}}/eureka/apps", "host": ["{{eurekaUrl}}"], "path": ["eureka", "apps"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Eureka responds', function () { pm.expect(pm.response.code).to.eql(200); });"] } }]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Login - ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": { "raw": "{{authUrl}}/api/v1/auth/login", "host": ["{{authUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Admin login succeeded', function () { pm.expect(pm.response.code).to.eql(200); });", "var j = pm.response.json();", "if (j.data && j.data.accessToken) pm.collectionVariables.set('admin_token', j.data.accessToken);"] } }]
        },
        {
          "name": "Login - MERCHANT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{merchant_username}}\",\n  \"password\": \"{{merchant_password}}\"\n}" },
            "url": { "raw": "{{authUrl}}/api/v1/auth/login", "host": ["{{authUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Merchant login succeeded', function () { pm.expect(pm.response.code).to.eql(200); });", "var j = pm.response.json();", "if (j.data && j.data.accessToken) pm.collectionVariables.set('merchant_token', j.data.accessToken);"] } }]
        },
        {
          "name": "Login - DELIVERY_AGENT (saved as delivery_partner_token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{delivery_partner_username}}\",\n  \"password\": \"{{delivery_partner_password}}\"\n}" },
            "url": { "raw": "{{authUrl}}/api/v1/auth/login", "host": ["{{authUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Delivery-agent login succeeded', function () { pm.expect(pm.response.code).to.eql(200); });", "var j = pm.response.json();", "if (j.data && j.data.accessToken) pm.collectionVariables.set('delivery_partner_token', j.data.accessToken);"] } }]
        }
      ]
    },
    {
