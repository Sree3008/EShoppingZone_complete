          "name": "Run previous-week settlement",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": { "raw": "{{gatewayUrl}}/api/v1/settlements/weekly/run", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "settlements", "weekly", "run"] } },
